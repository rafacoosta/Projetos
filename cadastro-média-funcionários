'''
Uma empresa precisa registrar funcionáriosionários e armazenar:nome, cargo e salário.
Após isso o sistema deve mostrar: todos os funcionáriosionários, média salarial e quem recebe acima da média
'''

funcionários = int(input("N° de funcionáriosionários a registrar: "))

nome = [0 for x in range(funcionários)]
cargo = [0 for x in range(funcionários)]
salario = [0 for x in range(funcionários)]

soma_salário = 0
for i in range (funcionários):
    print (f"funcionáriosionário {i+1}:")
    nome[i] = input("Nome: ")
    cargo[i] = input("Cargo: ")
    salario[i] = float(input("Salário:"))
    soma_salário = salario[i] + soma_salário

media = soma_salário / funcionários

for i in range (funcionários):
    print (f"funcionáriosioário: {nome[i]} | Salário: {salario[i]}")
print (f"Média salarial: {media}")
print (f"Acima da média")
for i in range (funcionários):
    if salario [i] > media:
        print (nome[i])
